            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/api/v1/egress-templates",
            "headers": [
              {
                "name": "tenant-id",
                "value": ""
              },
              {
                "name": "x-user-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entityType",
                "value": "",
                "type": "query",
                "description": "Filter by entity type (practitioner, facility)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status (active, inactive, draft)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of egress templates for a tenant with optional filtering"
