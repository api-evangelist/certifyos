                "type": "query",
                "description": "If true, includes only users who can be assigned to facility workflows"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all facility analyst users for the current tenant"
        },
        {
          "info": {
