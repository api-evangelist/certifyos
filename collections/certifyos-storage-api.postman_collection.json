          "name": "Download file from GCS with custom filename",
          "request": {
            "name": "Download file from GCS with custom filename",
            "description": {
              "content": "Downloads a file from Google Cloud Storage and sets a custom filename for the download",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "storage",
                "download"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "fileName",
                  "value": "<string>",
                  "description": "Optional custom filename for the download"
                },
                {
                  "disabled": false,
                  "key": "filePath",
                  "value": "<string>",
                  "description": "(Required) GCS object path"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Tenant ID",
                "key": "tenant-id",
                "value": "<string>"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
