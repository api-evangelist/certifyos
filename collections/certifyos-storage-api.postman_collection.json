          "id": "9f4aa299-ac44-4737-8f1b-6ed378bdcdc5",
          "name": "Generate presigned URL for file download",
          "request": {
            "name": "Generate presigned URL for file download",
            "description": {
              "content": "Creates a time-limited presigned URL (1 hour expiry) for direct file download from GCS",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "storage",
                "presigned-url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
