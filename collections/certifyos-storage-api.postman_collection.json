                  "disabled": false,
                  "key": "filePath",
                  "value": "<string>",
                  "description": "(Required) GCS object path"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Tenant ID",
                "key": "tenant-id",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
