{
  "opencollection": "1.0.0",
  "info": {
    "name": "Certifyos File Storage Resource API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "File Storage Resource",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/file/download",
            "headers": [
              {
                "name": "tenant-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Download File"
        },
        {
          "info": {
            "name": "Read File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:9000/file/read",
            "headers": [
              {
                "name": "tenant-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "path",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Read File"
        },
        {
          "info": {
            "name": "Upload Csv File",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:9000/file/upload",
            "headers": [
              {
                "name": "tenant-id",
                "value": ""
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Upload Csv File"
        }
      ]
    }
  ],
  "bundled": true
}