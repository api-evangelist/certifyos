              {
                "name": "tenant-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "ID of the monitoring workflow"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
