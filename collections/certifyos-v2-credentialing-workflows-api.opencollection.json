          "info": {
            "name": "Approve Provider Credentialing Workflow",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://ng-api-production.certifyos.com/v2/credentialing-workflows/:id/steps/move-to-cred-approved",
            "headers": [
              {
                "name": "organization-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Move a provider credentialing workflow to approved status.<br/><br/>\n     Approval Criteria<br/>\n      - The workflow must exist and be accessible to the current organization and user.<br/>\n      - The workflow can only be approved by Medical Director or Provisional Approver.<br/>\n      - The workflow must be in state (PSV ready, Tabled, Hold for Cred Comm) that allows the \n        requested transition.<br/>\n      - Once the workflow is in the approved state, it cannot be reverted by any user be"
        },
        {
          "info": {
            "name": "Deny Provider Credentialing Workflow",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://ng-api-production.certifyos.com/v2/credentialing-workflows/:id/steps/move-to-cred-denied",
