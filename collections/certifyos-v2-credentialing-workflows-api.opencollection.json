              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Move a provider credentialing workflow to cancel status.<br/><br/>\n      Cancellation Criteria<br/>\n      - The workflow must exist and be accessible to the current organization and user.<br/>\n      - The workflow can only be approved by Credentialing User, Supervisor, Medical Director or Provisional Approver.<br/>\n      - Once the workflow is in the cancelled state, it cannot be reverted by any user besides Supervisor.<br/>"
        },
