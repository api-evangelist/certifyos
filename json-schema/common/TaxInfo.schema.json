{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/common/TaxInfo.schema.json",
  "title": "TaxInfo",
  "type": "object",
  "description": "Represents the legal tax entity information associated with a group.",
  "properties": {
    "legalTaxName": {
      "type": "string",
      "description": "Legal tax name"
    },
    "taxEntityStates": {
      "type": "array",
      "description": "States where the tax entity operates",
      "items": {
        "type": "string"
      }
    },
    "irs575File": {
      "type": "string",
      "description": "Reference to the IRS 575 file"
    },
    "w9File": {
      "type": "string",
      "description": "Reference to the W9 file"
    }
  },
  "required": [
    "legalTaxName",
    "taxEntityStates",
    "irs575File",
    "w9File"
  ],
  "additionalProperties": false
}
