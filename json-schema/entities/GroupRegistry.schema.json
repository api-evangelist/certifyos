{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/GroupRegistry.schema.json",
  "title": "GroupRegistry",
  "description": "Represents Unique Group across the platform i.e. it's not scoped to any particular tenant or organization. A Group is a legal business entity which has tin",
  "type": "object",
  "properties": {
    "affiliation": {
      "type": "string",
      "description": "Affiliation name or code"
    },
    "npi": {
      "type": "string",
      "description": "National Provider Identifier"
    },
    "name": {
      "type": "string",
      "description": "Name of the group"
    },
    "tin": {
      "type": "string",
      "description": "Tax Identification Number"
    },
    "type": {
      "type": "string",
      "description": "Type of group"
    },
    "legalTaxName": {
      "type": "string",
      "description": "Legal tax name"
    },
    "active": {
      "type": "boolean",
      "description": "Indicates if the group is active"
    },
    "telemedicineAvailable": {
      "type": "boolean",
      "description": "Indicates if telemedicine services are available"
    },
    "taxInfo": {
      "$ref": "https://schemas.certifyos.com/common/TaxInfo.schema.json",
      "description": "Represents the legal tax entity information associated with a group."
    },
    "bedCount": {
      "type": "integer",
      "description": "Number of beds"
    },
    "dea": {
      "type": "string",
      "description": "Drug Enforcement Administration registration number"
    }
  },
  "required": [
    "name",
    "npi",
    "tin"
  ],
  "additionalProperties": false
}
