{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/TenantGroupLocationPractitionerNetwork.schema.json",
  "title": "TenantGroupLocationPractitionerNetwork",
  "description": "Represents the participation of a tenant group location practitioner in a specific plan.",
  "type": "object",
  "properties": {
    "networkPractitionerEffectiveDate": {
      "type": "string",
      "format": "date"
    },
    "networkPractitionerTerminationDate": {
      "type": "string",
      "format": "date"
    },
    "networkPractitionerTerminationInformedDate": {
      "type": "string",
      "format": "date"
    },
    "terminationReason": {
      "type": "string"
    },
    "networkPractitionerStatus": {
      "type": "string"
    },
    "participationType": {
      "type": "string"
    },
    "networkPractitionerCredentialingStatus": {
      "type": "string"
    },
    "networkPractitionerCredentialedDate": {
      "type": "string",
      "format": "date"
    },
    "networkPractitionerNextCredentialingDate": {
      "type": "string",
      "format": "date"
    },
    "panelStatus": {
      "type": "string"
    },
    "acceptingNewPatients": {
      "type": "boolean"
    },
    "officeHours": {
      "type": "array",
      "description": "Operating hours for each day of the week",
      "items": {
        "$ref": "#/$defs/OfficeHour"
      }
    },
    "appointmentPhone": {
      "type": "string"
    },
    "languageSpoken": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "practitionerRole": {
      "type": "string"
    },
    "suppressSiteFromDirectory": {
      "type": "boolean"
    },
    "hasDelegatedAuthority": {
      "type": "boolean"
    },
    "sourceSystem": {
      "type": "string"
    },
    "changeReason": {
      "type": "string"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "OfficeHour": {
      "type": "object",
      "description": "Operating hours for a specific day of the week",
      "properties": {
        "day": {
          "$ref": "https://schemas.certifyos.com/enums/DaysOfTheWeek.schema.json",
          "description": "Day of the week (three-letter abbreviation)"
        },
        "openTime": {
          "type": "string",
          "format": "time",
          "description": "Time when the location opens on this day"
        },
        "closeTime": {
          "type": "string",
          "format": "time",
          "description": "Time when the location closes on this day"
        },
        "closed": {
          "type": "boolean",
          "description": "Indicates if the location is closed on this day"
        }
      }
    }
  }
} 