{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/TenantGroupNetwork.schema.json",
  "title": "TenantGroupNetwork",
  "description": "Represents the network of a tenant group in a specific plan.",
  "type": "object",
  "properties": {
    "networkGroupEffectiveDate": {
      "type": "string",
      "format": "date"
    },
    "networkGroupTerminationDate": {
      "type": "string",
      "format": "date"
    },
    "networkGroupTerminationInformedDate": {
      "type": "string",
      "format": "date"
    },
    "terminationReason": {
      "type": "string"
    },
    "networkGroupStatus": {
      "type": "string"
    },
    "participationType": {
      "type": "string"
    },
    "networkGroupCredentialingStatus": {
      "type": "string"
    },
    "networkGroupCredentialedDate": {
      "type": "string",
      "format": "date"
    },
    "networkGroupNextCredentialingDate": {
      "type": "string",
      "format": "date"
    },
    "suppressSiteFromDirectory": {
      "type": "boolean"
    },
    "sourceSystem": {
      "type": "string"
    }
  },
  "unevaluatedProperties": false
}
