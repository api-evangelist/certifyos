{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/HsdSpecialty.schema.json",
  "title": "HsdSpecialty",
  "description": "Represents the HSD specialty information for a healthcare provider, including the name and code of the specialty.",
  "type": "object",
  "properties": {
    "name": {
      "description": "The name of the specialty.",
      "type": "string"
    },
    "code": {
      "description": "The code representing the specialty.",
      "type": "string"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "additionalProperties": false
}
