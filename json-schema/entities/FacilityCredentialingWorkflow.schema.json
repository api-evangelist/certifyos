{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/FacilityCredentialingWorkflow.schema.json",
  "title": "FacilityCredentialingWorkflow",
  "description": "Represents the facility credentialing workflow data stored in the data JSON field.",
  "type": "object",
  "properties": {
    "facility": {
      "$ref": "https://schemas.certifyos.com/entities/Facility.schema.json"
    },
    "credentialingCycle": {
      "description": "Cycle of credentialing the facility.",
      "type": "string",
      "enum": ["INITIAL", "RECREDENTIALING"]
    },
    "previousCredentialedDate": {
      "description": "Date of the previous credentialing.",
      "type": ["string", "null"],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "credentialingDueDate": {
      "description": "Date of the credentialing due.",
      "type": ["string", "null"],
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "assignments": {
      "description": "History of assignment changes for this workflow.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "description": "Reason for the assignment change.",
            "type": ["string", "null"]
          },
          "assignedBy": {
            "description": "User or system that made the change.",
            "type": "string"
          },
          "assignedFrom": {
            "description": "Previous assignee (if any).",
            "type": ["string", "null"]
          },
          "assignedTo": {
            "description": "Assignee after the change.",
            "type": ["string", "null"]
          },
          "assignedOn": {
            "description": "Timestamp when the change occurred.",
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["assignedBy", "assignedTo", "assignedOn"],
        "additionalProperties": false
      }
    },
    "facilityFileTypeChanges": {
      "description": "Tracks facilityFileType changes, with the most recent value always at index 0.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "description": "Reason for the facilityFileType change.",
            "type": "string"
          },
          "fileType": {
            "description": "Type of facility file associated with this credentialing workflow.",
            "type": "string",
            "enum": [
              "CLEAN", "NON_CLEAN", "PENDING"
            ]
          },
          "changedBy": {
            "description": "User or system that made the change.",
            "type": "string"
          },
          "changedOn": {
            "description": "Timestamp when the change occurred.",
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["fileType", "changedBy", "changedOn"],
        "additionalProperties": false
      }
    },
    "credentialingCycleChangeLog": {
      "description": "Tracks credentialingCycle changes, with the most recent value always at index 0.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "description": "Reason for the credentialingCycle change.",
            "type": ["string", "null"]
          },
          "credentialingCycle": {
            "description": "Cycle of credentialing the facility after the change.",
            "type": ["string", "null"]
          },
          "createdBy": {
            "description": "User or system that created the change log entry.",
            "type": "string"
          },
          "createdAt": {
            "description": "Timestamp when the change log entry was created.",
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["credentialingCycle", "createdBy", "createdAt"],
        "additionalProperties": false
      }
    },
    "lineOfBusinessChangeLog": {
      "type": "array",
      "description": "Array to track changes to the facility's line of business. The actual lineOfBusiness data is fetched from facility.lineOfBusiness on the workflow.",
      "items": {
        "type": "object",
        "properties": {
          "changedFrom": {
            "type": ["string", "null"],
            "description": "Previous line of business value"
          },
          "changedTo": {
            "type": ["string", "null"],
            "description": "New line of business value"
          },
          "changeReason": {
            "type": ["string", "null"],
            "description": "Reason for the change"
          },
          "createdBy": {
            "type": "string",
            "description": "User who made the change"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the change was made"
          }
        },
        "required": ["changedTo", "createdBy", "createdAt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["facility"],
  "additionalProperties": false,
  "unevaluatedProperties": false
}
