{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/CaqhRosters.schema.json",
  "title": "CaqhRosters",
  "description": "Shape of the data JSON object stored in the caqh_rosters Spanner table. Holds the CAQH roster attributes copied from misc_reporting.caqh_roster (BigQuery) that are not promoted to dedicated columns. All fields are optional and nullable, mirroring the sparse CAQH source.",
  "type": "object",
  "properties": {
    "platform": {
      "type": ["string", "null"],
      "description": "Source platform."
    },
    "organization_id": {
      "type": ["string", "null"],
      "description": "Source organization identifier from the CAQH roster."
    },
    "authorization_flag": {
      "type": ["string", "null"],
      "description": "Authorization flag."
    },
    "provider_status": {
      "type": ["string", "null"],
      "description": "CAQH status detail."
    },
    "po_provider_id": {
      "type": ["string", "null"],
      "description": "PO provider identifier."
    },
    "provider_first_name": {
      "type": ["string", "null"],
      "description": "Provider first name."
    },
    "provider_middle_name": {
      "type": ["string", "null"],
      "description": "Provider middle name."
    },
    "provider_last_name": {
      "type": ["string", "null"],
      "description": "Provider last name."
    },
    "provider_type": {
      "type": ["string", "null"],
      "description": "Provider type."
    },
    "provider_address1": {
      "type": ["string", "null"],
      "description": "Provider address line 1."
    },
    "provider_address2": {
      "type": ["string", "null"],
      "description": "Provider address line 2."
    },
    "provider_address_city": {
      "type": ["string", "null"],
      "description": "Provider address city."
    },
    "provider_address_state": {
      "type": ["string", "null"],
      "description": "Provider address state."
    },
    "provider_address_zip": {
      "type": ["string", "null"],
      "description": "Provider address zip."
    },
    "provider_birthdate": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Provider birthdate."
    },
    "provider_license_number": {
      "type": ["string", "null"],
      "description": "Provider license number."
    },
    "provider_license_state": {
      "type": ["string", "null"],
      "description": "License state abbreviation."
    },
    "provider_upin": {
      "type": ["string", "null"],
      "description": "Nullable legacy identifier."
    },
    "provider_dea": {
      "type": ["string", "null"],
      "description": "Sensitive identifier; analytics/debug only."
    },
    "provider_npi": {
      "type": ["string", "null"],
      "description": "NPI as carried in the CAQH source. Also promoted to the provider_npi column."
    },
    "roster_status": {
      "type": ["string", "null"],
      "description": "Roster status."
    },
    "non_responder_flag": {
      "type": ["string", "null"],
      "description": "Non responder flag."
    },
    "delegation_flag": {
      "type": ["string", "null"],
      "description": "Delegation flag."
    },
    "affiliation_flag": {
      "type": ["string", "null"],
      "description": "Affiliation flag."
    },
    "provider_practice_state": {
      "type": ["string", "null"],
      "description": "Provider practice state."
    },
    "anniversary_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Anniversary date."
    }
  }
}
