{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/TenantNetwork.schema.json",
  "title": "TenantNetwork",
  "description": "Represents a healthcare network associated with a tenant and payer.",
  "type": "object",
  "properties": {
    "networkName": {
      "description": "Name of the network",
      "type": "string"
    },
    "networkType": {
      "description": "Type of network",
      "type": "string"
    },
    "lineOfBusiness": {
      "description": "Line of business this network serves",
      "$ref": "https://schemas.certifyos.com/enums/LineOfBusiness.schema.json"
    },
    "serviceAreaCategory": {
      "description": "Area category for services",
      "type": "string"
    },
    "serviceArea": {
      "description": "Service coverage area",
      "type": "string"
    },
    "networkEffectiveDate": {
      "description": "Network effective start date",
      "type": "string",
      "format": "date"
    },
    "networkTermDate": {
      "description": "Network termination date",
      "type": "string",
      "format": "date"
    },
    "networkStatus": {
      "description": "Active, Terminated, Pending",
      "$ref": "https://schemas.certifyos.com/enums/NetworkStatus.schema.json"
    },
    "sourceSystem": {
      "description": "Origin of the record (e.g., API, File Upload)",
      "$ref": "https://schemas.certifyos.com/enums/SourceSystem.schema.json"
    },
    "changeReason": {
      "description": "Optional description of why a change was made",
      "type": "string"
    }
  },
  "required": ["networkName", "networkStatus"]
} 