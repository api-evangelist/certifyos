{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.certifyos.com/entities/TenantPlan.schema.json",
  "title": "TenantPlan",
  "description": "Represents a healthcare plan associated with a tenant and payer.",
  "type": "object",
  "properties": {
    "planName": {
      "description": "Name of the plan",
      "type": "string"
    },
    "planType": {
      "description": "Type of plan (e.g., HMO, PPO)",
      "$ref": "https://schemas.certifyos.com/enums/PlanType.schema.json"
    },
    "lineOfBusiness": {
      "description": "LOB under which plan operates (e.g., Commercial, Medicare, Medicaid)",
      "$ref": "https://schemas.certifyos.com/enums/LineOfBusiness.schema.json"
    },
    "coverageAreaCategory": {
      "description": "Type of area covered (e.g., National, Regional, County, State, ZIP)",
      "$ref": "https://schemas.certifyos.com/enums/CoverageAreaCategory.schema.json"
    },
    "coverageArea": {
      "description": "Geographic area covered",
      "type": "string"
    },
    "planEffectiveDate": {
      "description": "When the plan becomes active",
      "type": "string",
      "format": "date"
    },
    "planTermDate": {
      "description": "End of plan's validity",
      "type": "string",
      "format": "date"
    },
    "planStatus": {
      "description": "Active, Terminated, Pending, Inactive",
      "$ref": "https://schemas.certifyos.com/enums/PlanStatus.schema.json"
    },
    "delegationFlag": {
      "description": "Indicates if credentialing is delegated",
      "type": "boolean"
    },
    "sourceSystem": {
      "description": "Origin of the record (e.g., API, File Upload)",
      "$ref": "https://schemas.certifyos.com/enums/SourceSystem.schema.json"
    },
    "changeReason": {
      "description": "Optional description of why a change was made",
      "type": "string"
    }
  },
  "required": ["planName", "planType", "planStatus"]
} 